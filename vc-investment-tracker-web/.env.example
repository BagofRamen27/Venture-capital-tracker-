# Copy to .env.local for local testing (npm run dev). On Vercel, add these under
# Project > Settings > Environment Variables instead. Never commit real values.

# The ID in the sheet URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=

# The whole service-account key file (JSON) on one line, or base64 of it.
# Share the Google Sheet with the key's client_email as a Viewer.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional: set to "demo" to always show the bundled CSV snapshot.
DATA_SOURCE=
