# Copy this file to `.env` (same folder) and edit the values. Never commit your real .env file.

# Database. SQLite needs no setup. For PostgreSQL/Supabase later, e.g.:
# VCD_DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
VCD_DATABASE_URL=sqlite:///./data/vc_discovery.db

# REQUIRED for SEC Form D monitoring. The SEC asks automated tools to identify themselves
# with a name and email address: https://www.sec.gov/os/accessing-edgar-data
VCD_SEC_USER_AGENT=Your Name your.email@example.com

# Websites your dashboard is served from (comma-separated), so the browser may call the API.
VCD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional password for changes (POST/PATCH/PUT/DELETE). Leave empty for local-only use.
# When set, the dashboard must send it in the X-API-Key header.
VCD_API_TOKEN=

# Run the daily/weekly jobs inside the API server (true/false).
VCD_ENABLE_SCHEDULER=false

# Tuning (defaults are sensible)
VCD_HN_MIN_POINTS=20
VCD_HN_LOOKBACK_HOURS=48
VCD_SEC_LOOKBACK_DAYS=3
VCD_SEC_MAX_FILINGS_PER_RUN=150
VCD_STALE_AFTER_DAYS=180
